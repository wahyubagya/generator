# Database (LibSQL / Turso untuk Production di Vercel)
# Untuk development lokal, gunakan:
DATABASE_URL="file:./dev.db"

# Untuk production di Vercel (daftar gratis di https://turso.tech):
# DATABASE_URL="libsql://your-database-name.turso.io"
# DATABASE_AUTH_TOKEN="your-turso-auth-token"

# Rahasia enkripsi session JWT (ubah dengan string acak aman untuk production)
AUTH_SECRET="aureate-craft-super-secret-key-2026-production-ready"
